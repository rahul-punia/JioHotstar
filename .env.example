NODE_ENV=development
PORT=3000

# Must point at a replica set (or sharded cluster) — transactions are required.
MONGO_URI=mongodb://localhost:27017/?replicaSet=rs0
MONGO_DB_NAME=jiohotstar

# HS256 secret used to verify access tokens; the user id is read from the `sub` claim.
JWT_SECRET=change-me-to-a-long-random-secret

WATCHLIST_MAX_SIZE=500
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
DEFAULT_SORT_ORDER=desc
